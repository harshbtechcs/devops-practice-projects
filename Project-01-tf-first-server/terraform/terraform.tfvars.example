# Is file ko copy karo:  cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars git me commit NAHI hoti (.gitignore me hai)

aws_region      = "ap-south-1"
owner           = "harsh"
instance_type   = "t3.micro"
my_ip_cidr      = "YOUR.PUBLIC.IP.HERE/32" # curl ifconfig.me se apna IP nikalo
public_key_path = "~/.ssh/p01-key.pub"
